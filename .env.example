# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
GUILD_ID=your_discord_guild_id_here

# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Stripe Payment (Optional - for premium subscriptions)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs - Subscriptions (Monthly)
STRIPE_PRICE_BRONZE_MONTHLY=price_...     # $4.99/월
STRIPE_PRICE_SILVER_MONTHLY=price_...     # $9.99/월
STRIPE_PRICE_GOLD_MONTHLY=price_...       # $19.99/월
STRIPE_PRICE_DIAMOND_MONTHLY=price_...    # $34.99/월
STRIPE_PRICE_ELITE_MONTHLY=price_...      # $49.99/월

# Stripe Price IDs - One-time Products
STRIPE_PRICE_STARTER_PACK=price_...       # $2.99 일회성
STRIPE_PRICE_FOUNDER_PACK=price_...       # $99.99 평생

# Stripe Coupon IDs
STRIPE_COUPON_FIRST_SUBSCRIPTION_30=coupon_...  # 첫 구독 30% 할인
STRIPE_COUPON_TRIAL_7DAYS=coupon_...            # 7일 무료 체험

# Application
BASE_URL=https://homeland-bot.com
NODE_ENV=production

# Debug logging
PRISMA_LOG_QUERIES=false
