# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
# DISCORD_GUILD_ID=  # Optional: Set for guild-specific commands (faster updates)

# Database (SQLite)
DATABASE_URL="file:./homeland.db"

# Optional: session cleanup interval in minutes (default: 60)
# SESSION_CLEANUP_INTERVAL_MINUTES=60

# Optional: economy monitoring intervals in minutes
# ECONOMY_HOURLY_SNAPSHOT_INTERVAL_MINUTES=60
# ECONOMY_DAILY_SNAPSHOT_INTERVAL_MINUTES=1440
# ECONOMY_ALERT_CHECK_INTERVAL_MINUTES=10

# Optional: Discord channel ID for economy alert notifications
# ECONOMY_ALERT_CHANNEL_ID=

# Optional: Stripe billing readiness for Premium/Gem purchase
# STRIPE_SECRET_KEY=
# STRIPE_PREMIUM_PRICE_ID=
# STRIPE_SUCCESS_URL=
# STRIPE_CANCEL_URL=
