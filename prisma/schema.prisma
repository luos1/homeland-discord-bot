generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  discordId String     @id
  username  String
  character Character?
  onboarding OnboardingProgress?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model OnboardingProgress {
  userId String @id
  user   User   @relation(fields: [userId], references: [discordId], onDelete: Cascade)

  tutorialStarted     Boolean  @default(false)
  tutorialCompleted   Boolean  @default(false)
  tutorialSkipped     Boolean  @default(false)
  tutorialStep        Int      @default(1)
  tutorialStep1Reward Boolean  @default(false)
  tutorialStep2Reward Boolean  @default(false)
  tutorialStep3Reward Boolean  @default(false)
  tutorialStep4Reward Boolean  @default(false)
  tutorialCompletedAt DateTime?

  questChainStarted   Boolean  @default(false)
  questChainCompleted Boolean  @default(false)
  questStep           Int      @default(1)
  questProgress       Int      @default(0)
  questRewardClaimed  Boolean  @default(false)
  questStartedAt      DateTime?
  questCompletedAt    DateTime?

  firstCombatTipShown     Boolean   @default(false)
  firstProductionTipShown Boolean   @default(false)
  firstTradeTipShown      Boolean   @default(false)
  firstCombatAt           DateTime?
  firstProductionAt       DateTime?
  firstTradeAt            DateTime?

  battleWins        Int @default(0)
  productionActions Int @default(0)
  tradeActions      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Character {
  id               Int                @id @default(autoincrement())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [discordId], onDelete: Cascade)
  name             String
  class                    String
  advancedClass            String?
  productionClass          String?
  advancedProductionClass  String?
  level                    Int                @default(1)
  xp               Int                @default(0)
  hp               Int                @default(100)
  maxHp            Int                @default(100)
  mana             Int                @default(40)
  maxMana          Int                @default(40)
  attack           Int                @default(10)
  defense          Int                @default(5)
  gold             Int                @default(0)
  gems             Int                @default(0)
  winStreak        Int                @default(0)
  maxWinStreak     Int                @default(0)
  battleWins       Int                @default(0)
  bossKills        Int                @default(0)
  tradeVolume      Int                @default(0)
  productionLevel  Int                @default(1)
  productionXp     Int                @default(0)
  warriorMastery   Int                @default(0)
  rangerMastery    Int                @default(0)
  mageMastery      Int                @default(0)
  gathererMastery  Int                @default(0)
  blacksmithMastery Int               @default(0)
  alchemistMastery Int                @default(0)
  combatSession    CombatSession?
  equipment        Equipment[]
  skills           Skill[]
  resources        Resource[]
  gatherSessions   GatherSession[]
  craftingSessions CraftingSession[]
  marketListings   MarketListing[]
  auctionsAsSeller Auction[]           @relation("AuctionSeller")
  auctionsAsHighestBidder Auction[]    @relation("AuctionHighestBidder")
  auctionBids     AuctionBid[]
  orderBookOrders  OrderBook[]
  rankingEvents    RankingEvent[]
  consumables      Consumable[]
  wonFieldBosses   FieldBossEvent[]   @relation("FieldBossWinner")
  guildWarContributions GuildWarContribution[]
  fieldBossBids    FieldBossBid[]
  attendanceRecords AttendanceRecord[]
  dailyQuests      DailyQuest[]
  dailyQuestProfile DailyQuestProfile?
  hiddenQuests     HiddenQuestProgress[]
  hiddenQuestTriggerStats HiddenQuestTriggerStats?
  premiumSubscription PremiumSubscription?
  gemTransactions  GemTransaction[]
  gemExchanges     GemExchange[]
  priceAlerts      PriceAlert[]
  npcShopSales     NpcShopSale[]
  jobRespecHistories JobRespecHistory[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([level])
  @@index([battleWins])
  @@index([bossKills])
  @@index([gold])
  @@index([gems])
  @@index([productionLevel])
  @@index([tradeVolume])
}

model Equipment {
  id           Int       @id @default(autoincrement())
  characterId  Int
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name         String
  type         String
  rarity       String
  attack       Int       @default(0)
  defense      Int       @default(0)
  hp           Int       @default(0)
  mana         Int       @default(0)
  effect       String?
  equipped     Boolean   @default(false)
  upgradeLevel Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([characterId])
  @@index([equipped])
}

model Skill {
  id           Int       @id @default(autoincrement())
  characterId  Int
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skillKey     String
  skillLevel   Int       @default(1)
  equipped     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([characterId, skillKey])
  @@index([characterId])
  @@index([equipped])
}

model Resource {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  type        String
  name        String
  quantity    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([characterId, type])
  @@index([characterId])
}

model Consumable {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name        String
  type        String    // potion, food, scroll
  effect      String    // heal_hp, heal_mp, buff_regen, etc
  power       Int       // 효과 수치
  duration    Int?      // 지속 시간 (초, 버프용)
  quantity    Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([characterId, type, effect])
  @@index([characterId])
}


model GatherSession {
  id             String    @id @default(cuid())
  characterId    Int       @unique
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  resourceType   String
  startedAt      DateTime  @default(now())
  completesAt    DateTime
  quantity       Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model CraftingSession {
  id          String    @id @default(cuid())
  characterId Int       @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  recipeKey   String
  startedAt   DateTime  @default(now())
  completesAt DateTime
  quantity    Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MarketListing {
  id          Int       @id @default(autoincrement())
  sellerId    Int
  seller      Character @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  itemType    String    // resource or equipment
  itemKey     String    // resource type or equipment id
  itemName    String
  quantity    Int       @default(1)
  pricePerUnit Int
  totalPrice  Int
  itemData    Json?     // equipment snapshot JSON
  status      String    @default("active") // active, sold, cancelled
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  soldAt      DateTime?
  buyerId     Int?

  @@index([sellerId])
  @@index([status])
  @@index([itemType])
}

model DynamicPrice {
  id                Int      @id @default(autoincrement())
  itemType          String
  itemKey           String
  basePrice         Int
  currentMultiplier Float    @default(1.0)
  npcBuyPrice       Int
  npcSellPrice      Int
  supply24h         Int      @default(0)
  demand24h         Int      @default(0)
  lastUpdated       DateTime @default(now())

  @@unique([itemType, itemKey])
  @@index([lastUpdated])
}

model NpcShopSale {
  id         Int       @id @default(autoincrement())
  characterId Int
  character  Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  saleType   String
  itemKey    String
  itemName   String
  quantity   Int       @default(1)
  totalPrice Int
  createdAt  DateTime  @default(now())

  @@index([characterId, createdAt])
  @@index([saleType, createdAt])
  @@index([itemKey, createdAt])
}

model Auction {
  id              Int        @id @default(autoincrement())
  sellerId        Int
  seller          Character  @relation("AuctionSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  itemType        String
  itemKey         String
  itemName        String
  itemData        Json
  startPrice      Int
  currentPrice    Int
  reservePrice    Int?
  duration        Int
  status          String     @default("active")
  highestBidderId Int?
  highestBidder   Character? @relation("AuctionHighestBidder", fields: [highestBidderId], references: [id], onDelete: SetNull)
  bidCount        Int        @default(0)
  createdAt       DateTime   @default(now())
  expiresAt       DateTime
  completedAt     DateTime?
  bids            AuctionBid[]

  @@index([sellerId, status])
  @@index([status, expiresAt])
  @@index([highestBidderId])
}

model AuctionBid {
  id        Int       @id @default(autoincrement())
  auctionId Int
  bidderId  Int
  bidAmount Int
  bidAt     DateTime  @default(now())
  isWinning Boolean   @default(false)
  auction   Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder    Character @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([auctionId, bidAt])
  @@index([bidderId, bidAt])
}

model OrderBook {
  id          Int       @id @default(autoincrement())
  type        String    // buy or sell
  itemType    String    @default("resource")
  itemKey     String
  itemName    String
  price       Int
  quantity    Int
  userId      String
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  status      String    @default("open") // open, filled, cancelled
  filledAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([itemType, itemKey, type, status, price, createdAt])
  @@index([userId, status])
  @@index([characterId, status])
}

model TradeHistory {
  id          Int      @id @default(autoincrement())
  sellerId    Int
  buyerId     Int
  itemType    String
  itemKey     String
  itemName    String
  quantity    Int
  price       Int
  fee         Int
  createdAt   DateTime @default(now())

  @@index([sellerId])
  @@index([buyerId])
  @@index([createdAt])
  @@index([createdAt, sellerId])
  @@index([createdAt, buyerId])
}

model PremiumSubscription {
  userId         String    @id
  character      Character @relation(fields: [userId], references: [userId], onDelete: Cascade)
  planId         String
  startDate      DateTime
  endDate        DateTime
  autoFight      Boolean   @default(false)
  autoPotion     Boolean   @default(false)
  autoConsumable Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([planId])
  @@index([endDate])
}

model GemTransaction {
  id         Int       @id @default(autoincrement())
  userId     String
  character  Character @relation(fields: [userId], references: [userId], onDelete: Cascade)
  type       String
  amount     Int
  rate       Int
  note       String?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model GemExchange {
  id         Int       @id @default(autoincrement())
  userId     String
  character  Character @relation(fields: [userId], references: [userId], onDelete: Cascade)
  orderType  String
  amount     Int
  rate       Int
  fee        Int       @default(0)
  goldAmount Int       @default(0)
  status     String    @default("filled")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([orderType, status, createdAt])
  @@index([userId, createdAt])
}

model FeeConfig {
  id           Int      @id @default(autoincrement())
  configKey    String   @unique // market_fee, gem_fee, auction_fee
  baseRate     Float
  currentRate  Float
  minRate      Float
  maxRate      Float
  autoAdjust   Boolean  @default(true)
  lastAdjusted DateTime @default(now())
  adjustedBy   String?

  @@index([configKey])
}

model EconomySnapshot {
  id               Int      @id @default(autoincrement())
  snapshotType     String   @default("hourly") // hourly, daily, manual
  totalGold        Int      @default(0)
  totalTradeVolume Int      @default(0)
  resources        Json
  averagePrices    Json
  createdAt        DateTime @default(now())

  @@index([snapshotType, createdAt])
  @@index([createdAt])
}

model ResourcePriceHistory {
  id            Int      @id @default(autoincrement())
  resourceType  String
  resourceName  String
  averagePrice  Int
  tradeCount    Int      @default(0)
  totalQuantity Int      @default(0)
  snapshotType  String   @default("hourly") // trade, hourly, daily
  createdAt     DateTime @default(now())

  @@index([resourceType, createdAt])
  @@index([snapshotType, createdAt])
}

model ItemPriceHistory {
  id         Int      @id @default(autoincrement())
  itemType   String
  itemKey    String
  avgPrice   Int
  minPrice   Int
  maxPrice   Int
  volume     Int
  recordedAt DateTime @default(now())

  @@index([itemType, itemKey, recordedAt])
  @@index([recordedAt])
}

model EconomyAlert {
  id         Int      @id @default(autoincrement())
  alertType  String // inflation, abnormal_trade
  severity   String // warn, critical
  message    String
  metadata   Json?
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@index([alertType, createdAt])
  @@index([severity, createdAt])
  @@index([resolvedAt])
}

model PriceAlert {
  id            Int       @id @default(autoincrement())
  userId        String
  characterId   Int?
  character     Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  itemType      String
  itemKey       String
  alertType     String // price_drop, price_rise, auction_ending
  targetPrice   Int?
  isActive      Boolean   @default(true)
  lastTriggered DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, isActive])
  @@index([itemType, itemKey, alertType])
  @@index([characterId, isActive])
}

model RankingEvent {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  category    String
  value       Int
  createdAt   DateTime  @default(now())

  @@index([category, createdAt])
  @@index([characterId, category, createdAt])
}

model JobRespecHistory {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  jobType     String
  fromClass   String
  toClass     String
  cost        Int
  createdAt   DateTime  @default(now())

  @@index([characterId, createdAt])
  @@index([jobType, toClass, createdAt])
  @@index([createdAt])
}

model JobRespecDemand {
  id          Int      @id @default(autoincrement())
  jobType     String
  jobClass    String
  respecCount Int      @default(0)
  multiplier  Float    @default(1.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([jobType, jobClass])
  @@index([jobType, multiplier])
}

model CombatSession {
  id                 String    @id @default(cuid())
  characterId        Int       @unique
  character          Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  zone               String
  monsterName        String
  monsterHp          Int
  monsterMaxHp       Int
  monsterAttack      Int
  monsterDefense     Int
  monsterXpReward    Int
  monsterGoldMin     Int
  monsterGoldMax     Int
  playerHp           Int
  playerDefending    Boolean   @default(false)
  potionsRemaining   Int       @default(3)
  turn               Int       @default(1)
  isBossFight        Boolean   @default(false)
  bossId             String?
  monsterFirstStrike Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model BossEncounter {
  id             Int       @id @default(autoincrement())
  bossId         String    @unique
  lastDefeatedAt DateTime?
  defeatedBy     String?   // character name
  defeatedById   Int?      // character id
  respawnAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([respawnAt])
}

model DailyQuest {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  dayKey      String
  questType   String
  questKey    String
  title       String
  target      Int
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  rewardGold  Int       @default(0)
  rewardXp    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([characterId, dayKey, questKey])
  @@index([characterId, dayKey])
  @@index([dayKey])
}

model DailyQuestProfile {
  characterId         Int       @id
  character           Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  streak              Int       @default(0)
  lastAllClearDay     String?
  weekKey             String?
  weeklyCompletedDays Int       @default(0)
  weeklyRewardClaimed Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model AttendanceRecord {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  date        String    // YYYY-MM-DD (KST)
  streak      Int
  claimed     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([characterId, date])
  @@index([characterId])
  @@index([date])
}

// 숨겨진 퀘스트 시스템
model HiddenQuestProgress {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  
  questKey    String    // 퀘스트 식별자 (예: "ancient_warrior", "dark_secret")
  discovered  Boolean   @default(false) // 퀘스트 발견 여부
  accepted    Boolean   @default(false) // 퀘스트 수락 여부
  completed   Boolean   @default(false) // 퀘스트 완료 여부
  claimed     Boolean   @default(false) // 보상 수령 여부
  
  progress    Int       @default(0)     // 현재 진행도
  
  discoveredAt DateTime?
  acceptedAt   DateTime?
  completedAt  DateTime?
  claimedAt    DateTime?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([characterId, questKey])
  @@index([characterId])
  @@index([questKey])
}

// 숨겨진 퀘스트 트리거 통계 (발견 조건 추적)
model HiddenQuestTriggerStats {
  id          Int       @id @default(autoincrement())
  characterId Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  
  // 처치 통계
  totalMonsterKills    Int @default(0)
  skeletonKills        Int @default(0)
  direWolfKills        Int @default(0)
  undeadKnightKills    Int @default(0)
  goblinShamanKills    Int @default(0)
  ancientDragonKills   Int @default(0)
  
  // 존 방문 통계
  zone1Visits          Int @default(0)
  zone2Visits          Int @default(0)
  zone3Visits          Int @default(0)
  
  // 연속 출석
  maxAttendanceStreak  Int @default(0)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([characterId])
  @@index([characterId])
}

// 랜덤 NPC 시스템
model RandomNpcSpawn {
  id          Int       @id @default(autoincrement())
  
  npcType     String    // 'wandering_merchant', 'mysterious_elder', 'gambler'
  spawnedAt   DateTime  @default(now())
  expiresAt   DateTime  // 소멸 시간
  isActive    Boolean   @default(true)
  
  // 상호작용한 플레이어 추적
  interactedUserIds String[] @default([])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([npcType])
  @@index([isActive])
  @@index([expiresAt])
}

// 파티 시스템
model Party {
  id          Int       @id @default(autoincrement())
  
  leaderId    String    // 파티장 Discord ID
  name        String?   // 파티 이름 (선택)
  maxSize     Int       @default(4) // 최대 인원 (기본 4명)
  
  isActive    Boolean   @default(true)
  
  members     PartyMember[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([leaderId])
  @@index([isActive])
}

model PartyMember {
  id          Int       @id @default(autoincrement())
  
  partyId     Int
  party       Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  
  userId      String    // Discord ID
  characterId Int       // Character ID
  
  joinedAt    DateTime  @default(now())
  
  @@unique([partyId, userId])
  @@index([userId])
  @@index([characterId])
}

// ==========================================
// 🏰 Guild System
// ==========================================

model Guild {
  id            Int       @id @default(autoincrement())
  
  name          String    @unique // 길드 이름 (유니크)
  tag           String?   @unique // 길드 태그 [TAG] (선택, 유니크)
  description   String?   // 길드 설명
  
  masterId      String    // 길드 마스터 Discord ID
  
  level         Int       @default(1) // 길드 레벨
  xp            Int       @default(0) // 길드 경험치
  gold          Int       @default(0) // 길드 자금
  
  maxMembers    Int       @default(10) // 최대 인원 (레벨업으로 증가)
  memberCount   Int       @default(0) // 현재 멤버 수
  
  isRecruiting  Boolean   @default(true) // 모집 중 여부
  minLevel      Int       @default(1) // 가입 최소 레벨
  
  members       GuildMember[]
  storage       GuildStorage[]
  buffs         GuildBuff[]
  npcs          GuildNPC[]
  warParticipations GuildWarParticipant[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([masterId])
  @@index([isRecruiting])
  @@index([level])
}

model GuildMember {
  id            Int       @id @default(autoincrement())
  
  guildId       Int
  guild         Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  
  userId        String    // Discord ID
  characterId   Int       // Character ID
  
  rank          String    @default("MEMBER") // MASTER/OFFICER/MEMBER
  
  contributedXp Int       @default(0) // 기여 경험치
  contributedGold Int     @default(0) // 기여 골드
  
  joinedAt      DateTime  @default(now())
  
  @@unique([guildId, userId])
  @@index([userId])
  @@index([characterId])
  @@index([rank])
}

model GuildStorage {
  id            Int       @id @default(autoincrement())
  
  guildId       Int
  guild         Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  
  itemType      String    // 아이템 타입
  itemName      String    // 아이템 이름
  quantity      Int       @default(0) // 수량
  
  @@unique([guildId, itemType, itemName])
  @@index([guildId])
}

model GuildBuff {
  id            Int       @id @default(autoincrement())
  
  guildId       Int
  guild         Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  
  buffType      String    // EXP_BOOST/GOLD_BOOST/COMBAT_BOOST 등
  value         Float     // 버프 수치 (1.1 = +10%)
  
  isActive      Boolean   @default(true)
  expiresAt     DateTime? // 만료 시간 (null = 영구)
  
  @@index([guildId, isActive])
}

model GuildNPC {
  id            Int       @id @default(autoincrement())
  
  guildId       Int
  guild         Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  
  npcType       String    // MERCHANT/ELDER/GAMBLER 등
  npcName       String    // NPC 이름
  
  purchasedAt   DateTime  @default(now())
  weeklyCut     Float     @default(0.0) // 이번 주 수익
  
  @@unique([guildId, npcType])
  @@index([guildId])
}

// ==========================================
// ⚔️ PvP Arena System
// ==========================================

model ArenaBattle {
  id            Int       @id @default(autoincrement())
  
  player1Id     String    // Discord ID
  player2Id     String    // Discord ID
  
  player1Elo    Int       // 전투 전 ELO
  player2Elo    Int
  
  winnerId      String?   // 승자 Discord ID
  
  entryFee      Int       @default(100) // 입장료
  reward        Int       @default(200) // 보상 (입장료 x2)
  
  battleData    Json?     // 전투 로그
  
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  
  @@index([player1Id])
  @@index([player2Id])
  @@index([winnerId])
  @@index([createdAt])
}

model PlayerElo {
  id            Int       @id @default(autoincrement())
  
  userId        String    @unique // Discord ID
  
  elo           Int       @default(1000) // 시작 ELO
  wins          Int       @default(0)
  losses        Int       @default(0)
  
  lastBattleAt  DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([elo])
  @@index([wins])
}

model TheftAttempt {
  id            Int       @id @default(autoincrement())
  
  thiefId       String    // 도둑 Discord ID
  targetId      String    // 타겟 Discord ID
  
  success       Boolean   // 성공 여부
  amount        Int       // 훔친/벌금 골드
  
  createdAt     DateTime  @default(now())
  
  @@index([thiefId])
  @@index([targetId])
  @@index([createdAt])
}

model WeeklyRanking {
  id            Int       @id @default(autoincrement())
  
  userId        String
  week          String    // YYYY-WW 형식
  
  category      String    // pvp_wins/boss_kills/gold_earned/trades
  score         Int       @default(0)
  rank          Int?
  
  rewardClaimed Boolean   @default(false)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@unique([userId, week, category])
  @@index([week, category, score])
}

model DailyQuestProgress {
  id        Int      @id @default(autoincrement())
  userId    String
  date      String
  quests    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date], name: "userId_date")
}

model PremiumSubscription {
  id                    Int       @id @default(autoincrement())
  userId                String    @unique
  tier                  String    // bronze, silver, gold
  stripeCustomerId      String?
  stripeSubscriptionId  String?   @unique
  status                String    // active, canceled, past_due
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  canceledAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model PaymentHistory {
  id                    Int       @id @default(autoincrement())
  stripeInvoiceId       String    @unique
  stripeSubscriptionId  String
  amount                Float
  currency              String
  status                String    // succeeded, failed
  paidAt                DateTime?
  failedAt              DateTime?
  createdAt             DateTime  @default(now())
}

model FieldBossEvent {
  id          Int      @id @default(autoincrement())
  bossName    String
  bossLevel   Int
  bossHp      Int
  bossAttack  Int
  minBid      Int
  biddingEnd  DateTime
  status      String   // BIDDING, FIGHTING, COMPLETED, CANCELLED
  winnerId    Int?
  winner      Player?  @relation("FieldBossWinner", fields: [winnerId], references: [id])
  winningBid  Int?
  rewards     String   // JSON
  bids        FieldBossBid[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model FieldBossBid {
  id        Int              @id @default(autoincrement())
  eventId   Int
  event     FieldBossEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  playerId  Int
  player    Player           @relation(fields: [playerId], references: [id])
  amount    Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([eventId, playerId])
  @@index([eventId, amount])
}

model FieldBossEvent {
  id          Int      @id @default(autoincrement())
  bossName    String
  bossLevel   Int
  bossHp      Int
  bossAttack  Int
  minBid      Int
  biddingEnd  DateTime
  status      String   // BIDDING, FIGHTING, COMPLETED, CANCELLED
  winnerId    Int?
  winner      Character?  @relation("FieldBossWinner", fields: [winnerId], references: [id])
  winningBid  Int?
  rewards     String   // JSON
  bids        FieldBossBid[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model FieldBossBid {
  id        Int              @id @default(autoincrement())
  eventId   Int
  event     FieldBossEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  characterId  Int
  character Character         @relation(fields: [characterId], references: [id])
  amount    Int
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([eventId, characterId])
  @@index([eventId, amount])
}

model GuildWar {
  id           Int      @id @default(autoincrement())
  season       String   @unique
  startTime    DateTime
  endTime      DateTime
  status       String   // ACTIVE, COMPLETED
  participants GuildWarParticipant[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

model GuildWarParticipant {
  id            Int      @id @default(autoincrement())
  warId         Int
  war           GuildWar @relation(fields: [warId], references: [id], onDelete: Cascade)
  guildId       Int
  guild         Guild    @relation(fields: [guildId], references: [id])
  score         Int      @default(0)
  contributions GuildWarContribution[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([warId, guildId])
  @@index([warId, score])
}

model GuildWarContribution {
  id            Int      @id @default(autoincrement())
  participantId Int
  participant   GuildWarParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  characterId   Int
  character     Character @relation(fields: [characterId], references: [id])
  type          String   // MONSTER_KILL, BOSS_KILL, RESOURCE_GATHER, GOLD_DONATE, QUEST_COMPLETE
  value         Int
  points        Int
  createdAt     DateTime @default(now())

  @@index([participantId])
  @@index([characterId])
}

model ServerEvent {
  id         Int      @id @default(autoincrement())
  type       String   // xp_boost, gold_boost, drop_boost, all_boost
  name       String
  multiplier Float
  startTime  DateTime
  endTime    DateTime
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([active, endTime])
}
