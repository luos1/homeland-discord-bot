# ═══════════════════════════════════════════════════════════════
# Homeland Payment Server 환경변수
# ═══════════════════════════════════════════════════════════════

# 서버 설정
PORT=4000
BASE_URL=https://luos1.github.io/homeland-discord-bot

# ═══════════════════════════════════════════════════════════════
# 토스페이먼츠 (국내 결제)
# https://developers.tosspayments.com/my/api-keys
# ═══════════════════════════════════════════════════════════════
TOSS_CLIENT_KEY=test_ck_xxx
TOSS_SECRET_KEY=test_sk_xxx

# ═══════════════════════════════════════════════════════════════
# Paddle (해외 결제)
# https://vendors.paddle.com/authentication
# ═══════════════════════════════════════════════════════════════
PADDLE_API_KEY=xxx
PADDLE_WEBHOOK_SECRET=xxx

# Paddle 상품 가격 ID (Paddle 대시보드에서 생성)
PADDLE_PRICE_GEM_100=pri_xxx
PADDLE_PRICE_GEM_500=pri_xxx
PADDLE_PRICE_GEM_1000=pri_xxx
PADDLE_PRICE_GEM_3000=pri_xxx
PADDLE_PRICE_PREMIUM_MONTHLY=pri_xxx
PADDLE_PRICE_PREMIUM_YEARLY=pri_xxx

# ═══════════════════════════════════════════════════════════════
# 봇 연동 (결제 완료 시 알림)
# ═══════════════════════════════════════════════════════════════
BOT_WEBHOOK_URL=https://homeland-discord-bot-production.up.railway.app/api/payment-webhook
